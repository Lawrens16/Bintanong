COMPOSE_PROJECT_NAME=bintanong
MODELS_DIR=C:/Coding-projects/bintanong_workspace/MODELS
BINTU_MODEL_RELATIVE_PATH=GEMMA_4_E4B/gemma-4-E4B-it-UD-Q4_K_XL.gguf
BINTU_MODEL_SHA256=3CF61DE12DAA015EE0F7B68E7B7C541405BF220E1E942BAD8B47CAB827D7DF80
EMBEDDING_MODEL_RELATIVE_PATH=SEA-LION-E5-Embedding-600M
EMBEDDING_WEIGHTS_SHA256=DF5B1C55623EEB5EF09CE3F3C50E24E2DB433D7D1BBCCCF76D2F01BA212DF5F1
SUPABASE_DB_URL=postgresql://postgres:postgres@supabase_db_bintanong:5432/postgres
EMBEDDING_URL=http://embedding:8001
BINTU_URL=http://bintu:8080
API_INTERNAL_URL=http://api:8000
BINTU_REQUEST_TIMEOUT_SECONDS=120
BINTU_QUEUE_LIMIT=2
BINTU_GPU_LAYERS=8
BINTU_CONTEXT_SIZE=2048
BINTU_MAX_TOKENS=128

# Hosted-LLM agent API (Phase 13 fork; docker/agent-api.Dockerfile, render.yaml). Real values stay in the ignored .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public anon or publishable key; never the service-role key>
BINTANONG_LLM_PROVIDER=deepseek
# BINTANONG_LLM_MODEL=deepseek-flash
# BINTANONG_LLM_THINKING=1   (off by default: DeepSeek thinking tokens bill as output)
DEEPSEEK_API_KEY=
# OPENAI_API_KEY= / GEMINI_API_KEY= / ANTHROPIC_API_KEY=   (for the other providers)
BINTANONG_ALLOWED_ORIGINS=http://localhost:3217
BINTANONG_ALLOW_GUESTS=1
BINTANONG_RELEASE_ID=p12-research-faqsplit-20261030
BINTANONG_RESEARCH_AUTHORIZATION=research-owner-20261029
